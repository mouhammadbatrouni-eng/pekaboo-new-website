# Sanity — leave unset to run the site against bundled placeholder content
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Contact form (src/pages/api/contact.ts) — sent via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Website assistant (src/pages/api/chat.ts) — https://console.anthropic.com
# Server-side only: it is read in the API route and never reaches the browser.
# Leave unset to disable the chat endpoint (it returns 503 and the widget shows
# a fallback message, so the rest of the site is unaffected).
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-4-8. Set to claude-haiku-4-5 for a cheaper,
# faster assistant if FAQ-level answers are good enough for this traffic.
CHAT_MODEL=
