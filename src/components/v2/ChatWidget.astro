---
import type { Dict, Lang } from "../../lib/i18n";

/**
 * Floating assistant, answering from the site's own copy via /api/chat.
 *
 * Anchored to `start-*` because the WhatsApp action already owns `end-*`; both
 * are logical properties, so they swap sides together on the Arabic page and
 * never collide. WhatsApp stays the route to a human — this is for the
 * questions people won't open a conversation to ask.
 */
interface Props {
  t: Dict;
  lang: Lang;
}

const { t, lang } = Astro.props;
---

<div id="pb-chat" data-lang={lang} class="fixed bottom-5 start-5 z-40">
  <button
    type="button"
    data-chat-open
    class="group inline-flex items-center gap-2.5 rounded-full bg-brand-600 py-3.5 ps-4 pe-4 text-white shadow-[0_10px_30px_rgba(0,0,0,0.18)] transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 sm:pe-5"
    aria-label={t.chat.launcher}
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="hidden text-sm font-bold sm:inline">{t.chat.launcher}</span>
  </button>

  <section
    data-chat-panel
    hidden
    role="dialog"
    aria-modal="false"
    aria-label={t.chat.heading}
    class="flex h-[min(32rem,calc(100vh-6rem))] w-[min(23rem,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-3xl border border-black/10 bg-white shadow-[0_24px_60px_rgba(0,0,0,0.22)] dark:border-white/10 dark:bg-neutral-900"
  >
    <header class="flex items-start justify-between gap-3 border-b border-black/10 px-5 py-4 dark:border-white/10">
      <div>
        <p class="font-heading text-base font-bold text-neutral-900 dark:text-white">{t.chat.heading}</p>
        <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">{t.chat.subheading}</p>
      </div>
      <button
        type="button"
        data-chat-close
        class="-me-1.5 -mt-1 rounded-full p-1.5 text-neutral-400 transition-colors hover:text-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 dark:hover:text-white"
        aria-label={t.chat.close}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </header>

    <!-- aria-live so a screen reader hears the reply as it streams in. -->
    <div data-chat-log class="flex-1 space-y-3 overflow-y-auto px-5 py-4" aria-live="polite">
      <p class="max-w-[85%] rounded-2xl rounded-es-sm bg-neutral-100 px-3.5 py-2.5 text-sm text-neutral-800 dark:bg-white/10 dark:text-neutral-100">
        {t.chat.greeting}
      </p>
      <div data-chat-suggestions class="flex flex-wrap gap-1.5 pt-1">
        {t.chat.suggestions.map((s) => (
          <button
            type="button"
            data-chat-suggestion={s}
            class="rounded-full border border-black/10 px-3 py-1.5 text-start text-xs text-neutral-600 transition-colors hover:border-brand-500 hover:text-brand-700 dark:border-white/15 dark:text-neutral-300 dark:hover:text-white"
          >
            {s}
          </button>
        ))}
      </div>
    </div>

    <form data-chat-form class="border-t border-black/10 px-4 py-3 dark:border-white/10">
      <div class="flex items-end gap-2">
        <!-- dir="auto" so a question typed in the other language reads correctly. -->
        <textarea
          data-chat-input
          rows="1"
          dir="auto"
          maxlength="2000"
          placeholder={t.chat.placeholder}
          class="max-h-28 flex-1 resize-none rounded-xl border border-black/10 bg-white px-3 py-2 text-sm text-neutral-900 outline-none transition-colors placeholder:text-neutral-400 focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
        ></textarea>
        <button
          type="submit"
          data-chat-send
          class="inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-white transition-opacity hover:opacity-90 disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
          aria-label={t.chat.send}
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:-scale-x-100" aria-hidden="true">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
          </svg>
        </button>
      </div>
      <p class="mt-2 text-center text-[0.65rem] leading-tight text-neutral-400">{t.chat.disclaimer}</p>
    </form>
  </section>
</div>

<script>
  const strings = {
    error: document.documentElement.lang === "ar"
      ? "حدث خطأ ما. يرجى المحاولة مرة أخرى، أو استخدام نموذج التواصل أدناه."
      : "Something went wrong. Please try again, or use the contact form below.",
    rateLimited: document.documentElement.lang === "ar"
      ? "عدد كبير من الأسئلة في وقت قصير — يرجى الانتظار قليلًا ثم المحاولة مجددًا."
      : "That's a lot of questions at once — give it a moment and try again.",
  };

  const root = document.getElementById("pb-chat");
  if (root) {
    const panel = root.querySelector("[data-chat-panel]") as HTMLElement;
    const launcher = root.querySelector("[data-chat-open]") as HTMLButtonElement;
    const log = root.querySelector("[data-chat-log]") as HTMLElement;
    const form = root.querySelector("[data-chat-form]") as HTMLFormElement;
    const input = root.querySelector("[data-chat-input]") as HTMLTextAreaElement;
    const send = root.querySelector("[data-chat-send]") as HTMLButtonElement;
    const suggestions = root.querySelector("[data-chat-suggestions]") as HTMLElement;
    const lang = root.dataset.lang === "ar" ? "ar" : "en";

    // Full turn history, replayed to the API so follow-up questions keep context.
    const history: { role: "user" | "assistant"; content: string }[] = [];
    let busy = false;

    function setOpen(open: boolean) {
      panel.hidden = !open;
      launcher.hidden = open;
      if (open) input.focus();
    }

    function bubble(role: "user" | "assistant", text: string) {
      const el = document.createElement("p");
      el.dir = "auto";
      el.className =
        role === "user"
          ? "ms-auto max-w-[85%] rounded-2xl rounded-ee-sm bg-brand-600 px-3.5 py-2.5 text-sm text-white"
          : "max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-es-sm bg-neutral-100 px-3.5 py-2.5 text-sm text-neutral-800 dark:bg-white/10 dark:text-neutral-100";
      el.textContent = text;
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    async function ask(question: string) {
      if (busy || !question.trim()) return;
      busy = true;
      send.disabled = true;
      suggestions?.remove();

      bubble("user", question);
      history.push({ role: "user", content: question });
      input.value = "";
      input.style.height = "auto";

      const reply = bubble("assistant", "…");
      let text = "";

      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: history, lang }),
        });

        if (!res.ok || !res.body) {
          reply.textContent = res.status === 429 ? strings.rateLimited : strings.error;
          // Drop the unanswered turn so it isn't replayed as phantom context.
          history.pop();
          return;
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          text += decoder.decode(value, { stream: true });
          reply.textContent = text;
          log.scrollTop = log.scrollHeight;
        }
        if (text) history.push({ role: "assistant", content: text });
        else reply.textContent = strings.error;
      } catch {
        reply.textContent = strings.error;
        history.pop();
      } finally {
        busy = false;
        send.disabled = false;
      }
    }

    launcher.addEventListener("click", () => setOpen(true));
    root.querySelector("[data-chat-close]")?.addEventListener("click", () => setOpen(false));

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      ask(input.value);
    });

    // Enter sends; Shift+Enter is a newline — the convention people expect in chat.
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        ask(input.value);
      }
    });

    input.addEventListener("input", () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 112)}px`;
    });

    root.querySelectorAll("[data-chat-suggestion]").forEach((btn) => {
      btn.addEventListener("click", () =>
        ask((btn as HTMLElement).dataset.chatSuggestion ?? ""),
      );
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) setOpen(false);
    });
  }
</script>
