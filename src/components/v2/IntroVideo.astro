---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import SectionIntro from "./SectionIntro.astro";
import { Play, RotateCcw, ArrowRight, ArrowLeft, Languages } from "@lucide/astro";
import { routePath, type Dict, type Lang } from "../../lib/i18n";

interface Props {
  t: Dict;
  lang: Lang;
  rtl: boolean;
}

const { t, lang, rtl } = Astro.props;

/*
 * One cut per language. Chapter start times, in seconds, come from each
 * video's own frame timeline (English: peekaboo-intro-v01; Arabic: the RTL
 * rebuild in videos/peekaboo-arabic, cued to the Arabic narration). The opening
 * "five tools" beat folds into the first chapter — it is the setup for "Meet
 * Peekaboo", not a module of its own. If a video is re-cut, only its entry
 * here needs to move.
 */
const VIDEOS = {
  en: {
    src: "/video/peekaboo-intro.mp4",
    poster: "/video/peekaboo-intro-poster.jpg",
    chapters: [0, 13.8, 19.36, 26.52, 32.04, 37.24],
  },
  ar: {
    src: "/video/peekaboo-intro-ar.mp4",
    poster: "/video/peekaboo-intro-poster-ar.jpg",
    chapters: [0, 13.7, 19.5, 26.65, 32.0, 37.3],
  },
} as const satisfies Record<Lang, { src: string; poster: string; chapters: readonly number[] }>;

const { src, poster, chapters: CHAPTERS } = VIDEOS[lang];

/* One accent per chapter, cycling the palette so the rail reads as playful
   rather than a row of identical grey pills. */
const ACCENTS = ["brand", "mint", "coral", "violet", "gold", "brand"] as const;

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const Arrow = rtl ? ArrowLeft : ArrowRight;
---

<section id="watch" aria-labelledby="watch-heading" class="intro-video relative scroll-mt-28 py-16 sm:py-24">
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image:
      radial-gradient(46% 42% at 50% 38%, color-mix(in srgb, var(--color-brand-300) 18%, transparent), transparent 72%),
      radial-gradient(30% 34% at 88% 80%, color-mix(in srgb, var(--color-gold-300) 16%, transparent), transparent 72%),
      radial-gradient(28% 30% at 10% 70%, color-mix(in srgb, var(--color-coral) 10%, transparent), transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <Container class="relative">
    <SectionIntro id="watch-heading" eyebrow={t.intro.eyebrow} title={t.intro.heading} description={t.intro.body} />

    <div class="relative mx-auto mt-20 max-w-5xl sm:mt-24" data-reveal data-reveal-delay="100">
      {/* Confetti — the video's own sparkle marks, scattered around the frame. */}
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <svg class="sparkle absolute -top-10 end-[8%] h-7 w-7 text-gold-400" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.8 6.4 4.8 10.6 12 12-7.2 1.4-11.2 5.6-12 12-.8-6.4-4.8-10.6-12-12 7.2-1.4 11.2-5.6 12-12z"/></svg>
        <svg class="sparkle sparkle--b absolute -bottom-8 start-[6%] h-6 w-6 text-brand-400" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.8 6.4 4.8 10.6 12 12-7.2 1.4-11.2 5.6-12 12-.8-6.4-4.8-10.6-12-12 7.2-1.4 11.2-5.6 12-12z"/></svg>
        <svg class="sparkle sparkle--c absolute top-[38%] -end-8 hidden h-5 w-5 text-coral sm:block" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.8 6.4 4.8 10.6 12 12-7.2 1.4-11.2 5.6-12 12-.8-6.4-4.8-10.6-12-12 7.2-1.4 11.2-5.6 12-12z"/></svg>
        <span class="absolute top-[18%] -start-6 hidden h-3.5 w-3.5 rounded-full bg-mint sm:block"></span>
        <span class="absolute -bottom-4 end-[22%] h-2.5 w-2.5 rounded-full bg-violet"></span>
        <span class="absolute top-[70%] -start-3 hidden h-2 w-2 rounded-full bg-gold-400 sm:block"></span>
        {/* Soft glow that lifts the frame off the page. */}
        <div class="absolute inset-x-10 top-12 bottom-0 -z-10 rounded-[3rem] bg-brand-400/25 blur-3xl dark:bg-brand-400/15"></div>
      </div>

      {/*
        The mascot plays peek-a-boo with the frame: it peeks over the top edge
        while the video waits, ducks behind it once playback starts, and pops
        back up with a "Peek-a-boo!" when the video ends. It sits in the stack
        *below* the frame, so the frame's edge is what hides it.
      */}
      <div class="bird-peek pointer-events-none absolute -top-[54px] start-6 z-0 sm:-top-[74px] sm:start-14" aria-hidden="true">
        <span class="bird-bubble absolute -top-9 start-[46px] whitespace-nowrap sm:start-[62px] rounded-full border-2 border-ink-900 bg-gold-300 px-3 py-0.5 font-heading text-sm font-extrabold text-ink-900 shadow-soft">
          Peek-a-boo!
        </span>
        <img src="/peekaboo-bird.png" alt="" width="200" height="200" class="bird-img h-[72px] w-[72px] sm:h-[100px] sm:w-[100px]" loading="lazy" decoding="async" />
      </div>

      <div class="frame relative z-10 rounded-[2rem] p-[6px] shadow-soft-lg sm:p-2">
        <div class="relative aspect-video overflow-hidden rounded-[1.6rem] bg-[#fffaf5]">
          <video
            class="absolute inset-0 h-full w-full object-cover"
            src={src}
            poster={poster}
            preload="none"
            playsinline
            aria-label={t.intro.videoLabel}
            data-intro-video
          >
          </video>

          {/* Start screen. A real button over the poster, so play is one obvious
              target — keyboard and screen readers included. */}
          <button
            type="button"
            class="start-screen group absolute inset-0 flex cursor-pointer items-end justify-center bg-[linear-gradient(180deg,transparent_55%,rgba(16,24,40,0.28))] pb-[4%] focus-visible:outline-none sm:pb-[6%]"
            aria-label={`${t.intro.play} (${t.intro.duration})`}
            data-intro-start
          >
            <span class="flex items-center gap-3 sm:gap-4">
              <span class="play-orb relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[linear-gradient(180deg,#0e7fa8_0%,#0e77a1_100%)] text-white shadow-glow-brand ring-4 ring-white/70 transition-transform duration-300 group-hover:scale-110 group-focus-visible:outline-4 group-focus-visible:outline-offset-4 group-focus-visible:outline-brand-500 sm:h-20 sm:w-20 sm:ring-8">
                <span class="play-pulse absolute inset-0 rounded-full bg-brand-400/60" aria-hidden="true"></span>
                <Play size={28} fill="currentColor" class="relative ms-1 h-5 w-5 sm:h-7 sm:w-7" aria-hidden="true" />
              </span>
              <span class="hidden flex-col items-start gap-1.5 sm:flex">
                <span class="rounded-full bg-white/95 px-4 py-1.5 text-sm font-bold text-ink-900 shadow-soft sm:text-base">
                  {t.intro.play}
                  <span class="ms-1.5 tabular-nums text-ink-500">· {t.intro.duration}</span>
                </span>
                {
                  t.intro.languageNote && (
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-900/80 px-3 py-1.5 text-xs font-semibold text-white">
                      <Languages size={13} aria-hidden="true" />
                      {t.intro.languageNote}
                    </span>
                  )
                }
              </span>
            </span>
          </button>

          {/* End screen: the video's own close is "Get started", so the page
              hands the visitor that exact next step instead of a dead frame. */}
          <div
            class="end-screen absolute inset-0 hidden flex-col items-center justify-center gap-5 bg-ink-950/75 px-6 text-center backdrop-blur-sm"
            data-intro-end
          >
            <p class="font-heading text-2xl font-bold text-white sm:text-4xl">{t.intro.endTitle}</p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <Button href={routePath("getStarted", lang)} size="lg">
                {t.common.getStarted}
                <Arrow size={18} aria-hidden="true" />
              </Button>
              <button
                type="button"
                class="inline-flex items-center gap-2 rounded-full border border-white/25 px-6 py-3.5 font-bold text-white transition-colors hover:bg-white/10"
                data-intro-replay
              >
                <RotateCcw size={16} aria-hidden="true" />
                {t.intro.replay}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      t.intro.languageNote && (
        <p class="mt-4 flex items-center justify-center gap-1.5 text-xs font-semibold text-muted sm:hidden">
          <Languages size={13} aria-hidden="true" />
          {t.intro.languageNote}
        </p>
      )
    }

    {/* Chapter rail — the interactive half. Each chip seeks and plays, and the
        chip for the part that's on screen fills as it plays. */}
    <nav class="mx-auto mt-8 max-w-5xl" aria-label={t.intro.chaptersLabel} data-reveal data-reveal-delay="180">
      <ol class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
        {
          t.intro.chapters.map((title, i) => (
            <li>
              <button
                type="button"
                class={`chapter chapter--${ACCENTS[i]} group relative flex h-full w-full flex-col items-start gap-1 overflow-hidden rounded-lg border border-line bg-surface px-3.5 pt-3 pb-3.5 text-start shadow-soft transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-300`}
                data-chapter={CHAPTERS[i]}
                aria-label={`${title}, ${fmt(CHAPTERS[i]!)}`}
              >
                <span class="flex w-full items-center justify-between gap-2 text-[11px] font-bold tabular-nums text-subtle">
                  <span class="chapter-dot flex h-5 w-5 items-center justify-center rounded-full text-[10px] text-white">{i + 1}</span>
                  {fmt(CHAPTERS[i]!)}
                </span>
                <span class="text-sm font-bold leading-snug text-body">{title}</span>
                <span class="chapter-bar absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0" aria-hidden="true"></span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>
  </Container>
</section>

<style>
  /* Brand ramp border — the same sky→gold→mint run as the heading stroke. */
  .frame {
    background: linear-gradient(135deg, var(--color-brand-300), var(--color-gold-300) 55%, var(--color-mint));
  }

  /* ---- Mascot: peek, duck, pop ---- */
  .bird-peek {
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateY(18px);
  }
  .bird-img {
    animation: bird-bob 3.2s ease-in-out infinite alternate;
    filter: drop-shadow(0 6px 10px rgba(16, 24, 40, 0.18));
  }
  .bird-bubble {
    opacity: 0;
    transform: translateY(6px) scale(0.8) rotate(-4deg);
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* Peeks a little higher when the visitor reaches for play. */
  .intro-video:has(.start-screen:hover, .start-screen:focus-visible) .bird-peek {
    transform: translateY(4px);
  }
  .intro-video[data-state="playing"] .bird-peek,
  .intro-video[data-state="paused"] .bird-peek {
    transform: translateY(96px);
  }
  .intro-video[data-state="ended"] .bird-peek {
    transform: translateY(-6px);
  }
  .intro-video[data-state="ended"] .bird-bubble {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(-4deg);
  }

  @keyframes bird-bob {
    to {
      transform: translateY(-6px) rotate(-3deg);
    }
  }

  /* ---- Play button ---- */
  .play-pulse {
    animation: play-pulse 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes play-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  .intro-video:not([data-state="idle"]) .start-screen {
    display: none;
  }
  .intro-video[data-state="ended"] .end-screen {
    display: flex;
  }

  /* ---- Sparkles ---- */
  .sparkle {
    animation: twinkle 2.8s ease-in-out infinite alternate;
  }
  .sparkle--b {
    animation-delay: -1s;
  }
  .sparkle--c {
    animation-delay: -1.9s;
  }
  @keyframes twinkle {
    from {
      transform: scale(0.7) rotate(0deg);
      opacity: 0.55;
    }
    to {
      transform: scale(1.1) rotate(20deg);
      opacity: 1;
    }
  }

  /* ---- Chapter rail ---- */
  .chapter--brand { --accent: var(--color-brand-500); }
  .chapter--mint { --accent: #2fb582; }
  .chapter--coral { --accent: var(--color-coral); }
  .chapter--violet { --accent: var(--color-violet); }
  .chapter--gold { --accent: var(--color-gold-500); }

  .chapter-dot {
    background: var(--accent);
  }
  .chapter-bar {
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
  }
  :global([dir="rtl"]) .chapter-bar {
    transform-origin: right center;
  }
  .chapter[aria-current="true"] {
    border-color: var(--accent);
    box-shadow: 0 14px 28px -12px color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .bird-img,
    .play-pulse,
    .sparkle {
      animation: none;
    }
    .bird-peek,
    .bird-bubble {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".intro-video");
  const video = section?.querySelector<HTMLVideoElement>("[data-intro-video]");

  if (section && video) {
    const start = section.querySelector<HTMLButtonElement>("[data-intro-start]");
    const replay = section.querySelector<HTMLButtonElement>("[data-intro-replay]");
    const chips = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-chapter]"));
    const starts = chips.map((c) => Number(c.dataset.chapter));

    section.dataset.state = "idle";
    const setState = (s: "idle" | "playing" | "paused" | "ended") => (section.dataset.state = s);

    const play = (at?: number) => {
      video.controls = true;
      if (at !== undefined) video.currentTime = at;
      setState("playing");
      void video.play().catch(() => setState("paused"));
    };

    start?.addEventListener("click", () => play());
    replay?.addEventListener("click", () => play(0));
    chips.forEach((chip, i) => chip.addEventListener("click", () => play(starts[i])));

    video.addEventListener("play", () => setState("playing"));
    video.addEventListener("pause", () => {
      if (!video.ended) setState("paused");
    });
    video.addEventListener("ended", () => {
      video.controls = false;
      setState("ended");
      section.querySelector<HTMLElement>("[data-intro-end] a")?.focus({ preventScroll: true });
    });

    // Light up the chapter on screen and fill its bar as it plays.
    const sync = () => {
      const t = video.currentTime;
      const end = Number.isFinite(video.duration) ? video.duration : 45.3;
      chips.forEach((chip, i) => {
        const from = starts[i]!;
        const to = starts[i + 1] ?? end;
        const active = t >= from && t < to && section.dataset.state !== "idle";
        const progress = t >= to ? 1 : t <= from ? 0 : (t - from) / (to - from);
        chip.style.setProperty("--progress", String(section.dataset.state === "idle" ? 0 : progress));
        chip.setAttribute("aria-current", active ? "true" : "false");
      });
    };
    video.addEventListener("timeupdate", sync);
    video.addEventListener("seeked", sync);
    video.addEventListener("ended", sync);

    // Don't keep talking to someone who has scrolled away.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry && !entry.isIntersecting && !video.paused) video.pause();
        },
        { threshold: 0.25 },
      ).observe(video);
    }
  }
</script>
