---
import Container from "../ui/Container.astro";
import ScrollSection from "./ScrollSection.astro";
import Button from "../ui/Button.astro";
import AccentHeading from "../ui/AccentHeading.astro";
import SectionIntro from "./SectionIntro.astro";
import ContactForm from "./ContactForm.astro";
import { routePath, type Dict, type Lang } from "../../lib/i18n";

interface Props {
  t: Dict;
  lang: Lang;
}

const { t, lang } = Astro.props;
---

{/* Final push before the form — the last moment to make the case. */}
<section class="pt-20 sm:pt-28">
  <Container>
    <div class="relative overflow-hidden rounded-2xl bg-ink-950 px-7 py-14 text-center sm:px-16" data-reveal>
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_80%_at_50%_0%,var(--color-brand-700),transparent)] opacity-70"
        aria-hidden="true"
      >
      </div>
      <div class="relative">
        {/* Fixed-dark card, so the accent pins to a ramp value rather than
            the theme-flipping `brand-ink`. */}
        <AccentHeading
          text={t.contact.finalCtaHeading}
          class="mx-auto max-w-2xl text-3xl text-white sm:text-4xl"
          accentClass="text-brand-300"
        />
        <div class="mt-8">
          <Button href={routePath("getStarted", lang)} size="lg">{t.common.getStarted}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<ScrollSection id="contact" label={t.nav.contact}>
  <Container>
    {/* This block used to be a hand-copied SectionIntro, which is why it drifted
        out of step with the other eight. Using the real one keeps the eyebrow,
        rule and heading treatment identical across the journey. */}
    <SectionIntro
      id="contact-heading"
      step="09"
      eyebrow={t.contact.eyebrow}
      title={t.contact.heading}
      description={t.contact.body}
    />

    <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_300px] lg:gap-14">
      <div id="contact-form" class="scroll-mt-32">
        <ContactForm t={t} lang={lang} />
      </div>

      {/* Contact details live in the footer now, so this rail only sets
          expectations for the conversation the form starts. */}
      <aside class="lg:pt-2" data-reveal>
        <div class="rounded-2xl border border-line bg-surface p-6 shadow-soft">
          <h3 class="font-heading text-lg text-body">{t.contact.expect.title}</h3>
          <ol class="mt-4 space-y-3">
            {t.contact.expect.steps.map((step, index) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-xs font-bold text-brand-ink"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {step}
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </Container>
</ScrollSection>
