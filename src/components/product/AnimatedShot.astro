---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ShotMotion } from "./motion";

/**
 * A product capture that assembles itself and then stays alive.
 *
 * It is the same screenshot throughout: the still is the base layer (and the
 * whole story without JavaScript or with reduced motion). On top of it the
 * capture is cut into the screen's own pieces, which rise in one after another
 * each time the shot scrolls into view, followed by a few looping details.
 *
 * One image URL feeds the base and every piece, so the browser downloads the
 * capture once.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  motion: ShotMotion;
  /** Rendered width to request. Portal frames want more than phones. */
  width: number;
  quality?: number;
  /** `ratio` sizes by width and keeps the capture's shape; `fill` fills its box. */
  fit?: "ratio" | "fill";
  eager?: boolean;
}

const { src, alt, motion, width, quality = 80, fit = "ratio", eager = false } = Astro.props;

const image = await getImage({ src, width: Math.min(width, src.width), format: "webp", quality });
const url = `url("${image.src}")`;

const [W, H] = motion.ref;
const pct = (n: number, of: number) => (n / of) * 100;

/** CSS for a box showing exactly this region of the capture. */
function slice(x: number, y: number, w: number, h: number) {
  const pw = pct(w, W);
  const ph = pct(h, H);
  const bx = W === w ? 0 : (x / (W - w)) * 100;
  const by = H === h ? 0 : (y / (H - h)) * 100;
  return {
    box: `left:${pct(x, W)}%;top:${pct(y, H)}%;width:${pw}%;height:${ph}%;`,
    bg: `background-image:${url};background-size:${(100 / pw) * 100}% ${(100 / ph) * 100}%;background-position:${bx}% ${by}%;`,
  };
}

let order = 0;
const tiles = motion.bands.flatMap((band) => {
  const [y0, y1] = band.y;
  const xs = band.xs ?? [0, W];
  return xs.slice(0, -1).map((x0, i) => {
    const x1 = xs[i + 1]!;
    const s = slice(x0, y0, x1 - x0, y1 - y0);
    const delay = band.fixed ? 0 : ++order * 70;
    return { style: `${s.box}${s.bg}--d:${delay}ms;`, fixed: band.fixed, delay, x0, x1, y0, y1 };
  });
});
/* Looping details wait for the screen to finish arriving. */
const settled = order * 70 + 650;

/* A wipe rides in with the piece it sits on, so the bar or gauge is drawn
   once rather than shown, blanked and drawn again. */
const wipes = (motion.wipes ?? []).map(({ rect, cover }) => {
  const s = slice(...rect);
  const cx = rect[0] + rect[2] / 2;
  const cy = rect[1] + rect[3] / 2;
  const host = tiles.find((t) => cx >= t.x0 && cx < t.x1 && cy >= t.y0 && cy < t.y1);
  return { box: `${s.box}background:${cover};--d:${host?.delay ?? 0}ms;`, bg: s.bg };
});

const pulses = (motion.pulses ?? []).map(({ at, r, tone = "brand" }, i) => ({
  tone,
  style: `left:${pct(at[0], W)}%;top:${pct(at[1], H)}%;width:${pct(r * 2, W)}%;animation-delay:${settled + i * 320}ms;`,
}));

const taps = (motion.taps ?? []).map(([x, y], i) => ({
  style: `left:${pct(x, W)}%;top:${pct(y, H)}%;animation-delay:${settled + 400 + i * 1500}ms;`,
}));

const hops = (motion.hops ?? []).map(([x, y, w, h], i) => ({
  style: `left:${pct(x, W)}%;top:${pct(y, H)}%;width:${pct(w, W)}%;height:${pct(h, H)}%;animation-delay:${settled + i * 1300}ms;`,
}));
---

<div
  class:list={["shot relative overflow-hidden", fit === "fill" ? "h-full w-full" : "w-full"]}
  style={`${fit === "ratio" ? `aspect-ratio:${src.width}/${src.height};` : ""}--veil:${motion.veil};--settled:${settled}ms;`}
  data-shot
>
  <img
    src={image.src}
    alt={alt}
    width={image.attributes.width}
    height={image.attributes.height}
    class="absolute inset-0 h-full w-full object-cover object-top"
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
  />

  <div class="shot-layers pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="shot-veil absolute inset-0"></div>
    {tiles.map((tile) => <div class:list={["shot-tile absolute", tile.fixed && "shot-tile--fixed"]} style={tile.style} />)}
    {
      wipes.map((wipe) => (
        <div class="shot-wipe absolute" style={wipe.box}>
          <div class="shot-wipe-fill absolute inset-0" style={wipe.bg} />
        </div>
      ))
    }
    {hops.map((hop) => <div class="shot-hop absolute" style={hop.style} />)}
    {pulses.map((pulse) => <span class:list={["shot-pulse absolute", `shot-pulse--${pulse.tone}`]} style={pulse.style} />)}
    {taps.map((tap) => <span class="shot-tap absolute" style={tap.style} />)}
  </div>
</div>

<style>
  .shot {
    container-type: inline-size;
  }

  /*
   * Everything animated is opt-in: the layers exist only once the script has
   * armed the shot, so no-JS visitors and reduced-motion visitors get the
   * plain still underneath.
   */
  .shot-layers {
    display: none;
  }
  .shot[data-armed] .shot-layers {
    display: block;
  }

  .shot-veil {
    background: var(--veil);
  }
  /* Once every piece has landed the veil leaves, so any hairline between two
     pieces shows the identical still beneath rather than a flat colour. */
  .shot.is-live .shot-veil {
    opacity: 0;
    transition: opacity 0.3s linear var(--settled);
  }

  .shot-tile {
    background-repeat: no-repeat;
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }
  .shot-tile--fixed {
    opacity: 1;
    transform: none;
  }
  .shot.is-live .shot-tile {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease-out var(--d),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1) var(--d);
  }

  /* ---- Bars and gauges that redraw ---- */
  .shot-wipe {
    opacity: 0;
    transform: translateY(14px) scale(0.985);
  }
  .shot.is-live .shot-wipe {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease-out var(--d),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1) var(--d);
  }
  .shot-wipe-fill {
    background-repeat: no-repeat;
    clip-path: inset(0 100% 0 0);
  }
  .shot.is-live .shot-wipe-fill {
    animation: shot-wipe 7s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--settled) - 300ms) infinite;
  }
  @keyframes shot-wipe {
    0% {
      clip-path: inset(0 100% 0 0);
      opacity: 1;
    }
    20%,
    92% {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    99% {
      clip-path: inset(0 0 0 0);
      opacity: 0;
    }
    100% {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
    }
  }

  /* ---- Pings ---- */
  .shot-pulse {
    aspect-ratio: 1;
    border-radius: 9999px;
    translate: -50% -50%;
    opacity: 0;
  }
  .shot-pulse--brand {
    background: rgba(28, 182, 234, 0.55);
  }
  .shot-pulse--green {
    background: rgba(34, 197, 94, 0.5);
  }
  .shot.is-live .shot-pulse {
    /* Start offsets are set per element, inline. */
    animation: shot-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes shot-pulse {
    0% {
      transform: scale(0.7);
      opacity: 0.75;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  /* ---- Finger taps ---- */
  .shot-tap {
    width: 11cqw;
    aspect-ratio: 1;
    border-radius: 9999px;
    translate: -50% -50%;
    background: rgba(23, 32, 54, 0.28);
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, 0.85);
    opacity: 0;
  }
  .shot.is-live .shot-tap {
    animation: shot-tap 6s ease-out infinite;
  }
  @keyframes shot-tap {
    0% {
      transform: scale(1.5);
      opacity: 0;
    }
    4% {
      transform: scale(0.85);
      opacity: 1;
    }
    9% {
      transform: scale(0.7);
      opacity: 1;
    }
    18%,
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  /* ---- Stepping highlight (five stops) ---- */
  .shot-hop {
    border-radius: 1.4cqw;
    box-shadow:
      0 0 0 0.22cqw var(--color-brand-500),
      0 0.6cqw 1.8cqw rgba(28, 182, 234, 0.35);
    opacity: 0;
  }
  .shot.is-live .shot-hop {
    animation: shot-hop 6.5s ease-in-out infinite;
  }
  @keyframes shot-hop {
    0% {
      opacity: 0;
      transform: scale(0.96);
    }
    4%,
    17% {
      opacity: 1;
      transform: scale(1);
    }
    22%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
</style>

<script>
  /*
   * Arms every shot, then marks it live while it is on screen. Leaving the
   * viewport resets it, so scrolling back replays the build. A shot inside a
   * hidden layer (the stacked phone in the app story) waits until its layer is
   * the one showing.
   */
  const shots = Array.from(document.querySelectorAll<HTMLElement>("[data-shot]"));
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (shots.length > 0 && "IntersectionObserver" in window && !still) {
    const inView = new WeakMap<HTMLElement, boolean>();
    const apply = (el: HTMLElement) =>
      el.classList.toggle("is-live", inView.get(el) === true && !el.closest('[aria-hidden="true"]'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.intersectionRatio >= 0.3) inView.set(el, true);
          else if (!entry.isIntersecting) inView.set(el, false);
          apply(el);
        }
      },
      { threshold: [0, 0.3] },
    );

    for (const el of shots) {
      el.setAttribute("data-armed", "");
      observer.observe(el);
    }

    const layers = document.querySelectorAll("[data-app-screen]");
    if (layers.length > 0) {
      const watcher = new MutationObserver(() => shots.forEach(apply));
      layers.forEach((layer) => watcher.observe(layer, { attributes: true, attributeFilter: ["aria-hidden"] }));
    }
  }
</script>
