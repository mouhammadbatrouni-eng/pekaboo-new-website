---
import AnimatedShot from "./AnimatedShot.astro";
import { appShot, type AppShot } from "./screenshots";
import { appMotion } from "./motion";
import type { Lang } from "../../lib/i18n";

/**
 * A single app capture, filling whatever box it's placed in — no frame.
 *
 * Used on its own when several screens are stacked inside one PhoneFrame and
 * cross-faded; PhoneFrame renders it for the simple single-screen case.
 */
interface Props {
  shot: AppShot;
  alt: string;
  eager?: boolean;
  /** Which language's capture to show. */
  lang?: Lang;
}

const { shot, alt, eager = false, lang = "en" } = Astro.props;
---

<AnimatedShot
  src={appShot(shot, lang)}
  alt={alt}
  motion={appMotion(shot, lang)}
  width={402}
  quality={82}
  fit="fill"
  eager={eager}
/>
