---
import AnimatedShot from "./AnimatedShot.astro";
import { APP_SHOTS, type AppShot } from "./screenshots";
import { APP_MOTION } from "./motion";

/**
 * A single app capture, filling whatever box it's placed in — no frame.
 *
 * Used on its own when several screens are stacked inside one PhoneFrame and
 * cross-faded; PhoneFrame renders it for the simple single-screen case.
 */
interface Props {
  shot: AppShot;
  alt: string;
  eager?: boolean;
}

const { shot, alt, eager = false } = Astro.props;
---

<AnimatedShot
  src={APP_SHOTS[shot]}
  alt={alt}
  motion={APP_MOTION[shot]}
  width={402}
  quality={82}
  fit="fill"
  eager={eager}
/>
