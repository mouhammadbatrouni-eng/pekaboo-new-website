---
import AnimatedShot from "./AnimatedShot.astro";
import PortalFrameChrome from "./PortalFrameChrome.astro";
import { portalShot, type PortalShot } from "./screenshots";
import { portalMotion } from "./motion";
import type { Lang } from "../../lib/i18n";

/**
 * A browser window holding a real capture of the Peekaboo Care portal.
 *
 * The window is sized by its column and the capture keeps its own 16:10 ratio,
 * so nothing is ever stretched. The chrome (traffic lights, address pill)
 * is shared with the screens still drawn in markup, so those sit beside
 * these without looking like a different product.
 */
interface Props {
  shot: PortalShot;
  /** Describes the screen for people who can't see it. */
  alt: string;
  class?: string;
  /** Above-the-fold frames should not lazy-load. */
  eager?: boolean;
  /** Which language's capture to show. */
  lang?: Lang;
}

const { shot, alt, class: className = "", eager = false, lang = "en" } = Astro.props;
const src = portalShot(shot, lang);
---

<PortalFrameChrome class={className}>
  {/* The capture keeps its native ratio — never cropped, never stretched —
      and builds itself in when it scrolls into view (see motion.ts). */}
  <AnimatedShot src={src} alt={alt} motion={portalMotion(shot, lang)} width={1400} quality={78} eager={eager} />
</PortalFrameChrome>
